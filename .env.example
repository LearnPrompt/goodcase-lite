# 全部可选。什么都不配也能跑：站点会使用内置的样例案例数据。
# All optional. The site runs without any of these, using built-in sample cases.

# 接入你自己的 Supabase（可选）/ Bring your own Supabase (optional)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 仅服务端使用，绝不能暴露给浏览器 / Server-side only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# 站点地址 / Public site origin
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# 钉住首页焦点案例的 slug（留空则取最新）/ Pin the homepage featured case (optional)
GOODCASE_FEATURED_CASE_SLUG=

# 开启 Vercel 图片优化（默认关闭直出原图）/ Enable Vercel image optimization
GOODCASE_OPTIMIZE_IMAGES=
