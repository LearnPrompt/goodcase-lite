# 全部可选。什么都不配也能跑：站点会使用内置的样例案例数据。
# All optional. The site runs without any of these, using built-in sample cases.

# 接入你自己的 Supabase（可选）/ Bring your own Supabase (optional)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 仅服务端使用，绝不能暴露给浏览器 / Server-side only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# 站点地址 / Public site origin
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# 钉住首页焦点案例的 slug（留空则取最新）/ Pin the homepage featured case (optional)
GOODCASE_FEATURED_CASE_SLUG=

# 开启 Vercel 图片优化（默认关闭直出原图）/ Enable Vercel image optimization
GOODCASE_OPTIMIZE_IMAGES=

# Optional / 可选：以下变量均可留空，站点在没有它们时正常运行

# 反向代理/CDN 后面的对外规范域名，用于生成绝对链接 / Canonical public origin behind a proxy or CDN
GOODCASE_CANONICAL_ORIGIN=
# 是否将旧路径 301 到新路径，"true" 开启 / Redirect legacy paths with 301, set to "true" to enable
GOODCASE_ENABLE_LEGACY_REDIRECT=
# 站长通知 Webhook 地址（如飞书/Slack 机器人）/ Owner notification webhook URL (e.g. Feishu/Slack bot)
GOODCASE_OWNER_WEBHOOK_URL=
# Webhook 消息格式，配合上面的地址使用 / Webhook payload format, used together with the URL above
GOODCASE_OWNER_WEBHOOK_FORMAT=
# 手动触发 ISR 重新验证的密钥 / Secret for manually triggering ISR revalidation
GOODCASE_REVALIDATE_SECRET=
# 触发一次 Vercel 部署的 Deploy Hook 地址 / Vercel Deploy Hook URL to trigger a redeploy
VERCEL_DEPLOY_HOOK_URL=
# IndexNow 提交用的密钥 / Key used for IndexNow submissions
INDEXNOW_KEY=
# 百度站长验证 / Baidu site verification
BAIDU_SITE_VERIFICATION=
# Bing 站长验证 / Bing site verification
BING_SITE_VERIFICATION=
# 字节跳动站长验证 / ByteDance site verification
BYTEDANCE_SITE_VERIFICATION=
# Google 站长验证 / Google site verification
GOOGLE_SITE_VERIFICATION=
# 神马搜索站长验证 / Shenma (SM) search site verification
SM_SITE_VERIFICATION=
# 搜狗站长验证 / Sogou site verification
SOGOU_SITE_VERIFICATION=
